# ==============================================================================
# Brightloop Subscription Management System — Backend Environment Configuration
# ==============================================================================

# Database Connection
# For local SQLite development (default):
DATABASE_URL=sqlite:///./subscription_mgmt.db
# For PostgreSQL in staging or production:
# DATABASE_URL=postgresql://user:password@localhost:5432/subscription_mgmt

# JWT Authentication Security
# IMPORTANT: In production, generate a secure random 32+ character key:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-this-to-a-secure-random-secret-key-at-least-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# SMTP / Email Notifications
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASSWORD=your-app-specific-password
FROM_EMAIL=noreply@brightloop.com

# Application URLs
APP_NAME=Brightloop Subscription Management System
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000

# Environment: "development", "testing", or "production"
# When set to "production", an insecure SECRET_KEY will cause startup validation to fail.
ENVIRONMENT=development

